<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Beat Saber 1.40.8 plugin (D-001). Thin game/UI layer only: logic lives in SkillProgression.Core / .Data (D-014).
    BeatSaberDir comes from SkillProgression.Plugin.csproj.user (gitignored), e.g.
      <BeatSaberDir>C:\Users\...\BSInstances\1.40.8</BeatSaberDir>
    Builds copy SkillProgression.dll to Plugins/ (BSMT). Core/Data are compiled into it (one shipped DLL); their own
    projects still build separately for the tests and the CLI.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>SkillProgression</AssemblyName>
    <RootNamespace>SkillProgression.Plugin</RootNamespace>
    <Version>1.0.0</Version>
    <!-- C# 14 is required by the Reactive v2 source generator (D-002) -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AppOutputBase>$(MSBuildProjectDirectory)/</AppOutputBase>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="manifest.json" />
    <EmbeddedResource Include="Resources/to-improve.png" />
    <None Include="SkillProgression.Plugin.csproj.user" Condition="Exists('SkillProgression.Plugin.csproj.user')" />
  </ItemGroup>

  <!-- Core/Data sources compiled into the plugin instead of shipped in Libs/ (user, 2026-11-11). Same LangVersion and
       Nullable for all projects (Directory.Build.props); Core's IsExternalInit duplicates the plugin's. -->
  <ItemGroup>
    <Compile Include="..\SkillProgression.Core\**\*.cs" Exclude="..\SkillProgression.Core\obj\**;..\SkillProgression.Core\bin\**;..\SkillProgression.Core\IsExternalInit.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\SkillProgression.Data\**\*.cs" Exclude="..\SkillProgression.Data\obj\**;..\SkillProgression.Data\bin\**" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Game -->
  <ItemGroup>
    <Reference Include="Main" Publicize="true"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/Main.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="HMUI" Publicize="true"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/HMUI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="BeatSaber.ViewSystem" Publicize="true"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/BeatSaber.ViewSystem.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Interactable"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/Interactable.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SegmentedControl"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/SegmentedControl.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="HMLib"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/HMLib.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="GameplayCore"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/GameplayCore.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="DataModels"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/DataModels.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="BeatmapCore"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/BeatmapCore.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Colors"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/Colors.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="BGLib.AppFlow"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/BGLib.AppFlow.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="BGLib.Polyglot"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/BGLib.Polyglot.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="BGLib.UnityExtension"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/BGLib.UnityExtension.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Zenject"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/Zenject.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Zenject-usage"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/Zenject-usage.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="PlatformUserModel"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/PlatformUserModel.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression"><HintPath>$(BeatSaberDir)/Libs/System.IO.Compression.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="IPA.Loader"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/IPA.Loader.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/Unity.TextMeshPro.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/UnityEngine.UI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(BeatSaberDir)/Beat Saber_Data/Managed/UnityEngine.UIModule.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <!-- Mods (never shipped by us) -->
  <ItemGroup>
    <Reference Include="SiraUtil" Publicize="true"><HintPath>$(BeatSaberDir)/Plugins/SiraUtil.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="BSML"><HintPath>$(BeatSaberDir)/Plugins/BSML.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SongCore"><HintPath>$(BeatSaberDir)/Plugins/SongCore.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Reactive"><HintPath>$(BeatSaberDir)/Libs/Reactive.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Reactive.Components"><HintPath>$(BeatSaberDir)/Libs/Reactive.Components.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Reactive.BeatSaber"><HintPath>$(BeatSaberDir)/Plugins/Reactive.BeatSaber.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(BeatSaberDir)/Libs/Newtonsoft.Json.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Reactive v2 state generator / analyzers (compile time only) -->
    <PackageReference Include="Reactive.Compiler" Version="1.0.0" PrivateAssets="all" />
    <CompilerVisibleProperty Include="Configuration" />
    <PackageReference Include="BeatSaberModdingTools.Tasks" Version="2.0.0-beta7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- Release zip (D-043): BSMT zips $(ArtifactDestination) after CopyToArtifactDestination; the model goes in with the
       plugin so the zip is the complete release (Plugins/ + UserData/SkillProgression/model.json.gz). -->
  <Target Name="CopyModelToArtifact" AfterTargets="CopyToArtifactDestination" BeforeTargets="BSMT_ZipRelease" Condition="'$(Configuration)' == 'Release'">
    <Warning Text="data/model/model.json.gz not found: the release zip has no model (build it with training/build_model.py)."
             Condition="!Exists('$(MSBuildThisFileDirectory)../../data/model/model.json.gz')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../data/model/model.json.gz" DestinationFolder="$(ArtifactDestination)/UserData/SkillProgression"
          Condition="Exists('$(MSBuildThisFileDirectory)../../data/model/model.json.gz')" />
  </Target>

  <Target Name="CopyModelToGame" AfterTargets="Build" Condition="'$(BeatSaberDir)' != '' And '$(DisableCopyToPlugins)' != 'True'">
    <!-- Dev convenience until model hosting is decided: the locally built model goes to UserData. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../data/model/model.json.gz" DestinationFolder="$(BeatSaberDir)/UserData/SkillProgression"
          SkipUnchangedFiles="true" Condition="Exists('$(MSBuildThisFileDirectory)../../data/model/model.json.gz')" />
  </Target>
</Project>
